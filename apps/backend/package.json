{
  "name": "@nex/backend",
  "private": true,
  "version": "0.0.1",
  "description": "Nex minimal sync API \u2014 present from v1 as infrastructure, dormant until v2 sync ships.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:migrations",
    "build:migrations": "node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
