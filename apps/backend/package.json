{
  "name": "@nex/backend",
  "private": true,
  "version": "0.0.1",
  "description": "Nex minimal sync API \u2014 present from v1 as infrastructure, dormant until v2 sync ships.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:migrations",
    "build:migrations": "node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/services/merge.test.ts src/services/merge.conformance.test.ts src/routes/routes.test.ts src/routes/feedback.test.ts src/env.test.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
