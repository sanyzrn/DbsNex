    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "eslint": "9.18.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  }
}
