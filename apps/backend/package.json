{
  "name": "@nex/backend",
  "private": true,
  "version": "0.0.1",
  "description": "Nex minimal sync API \u2014 present from v1 as infrastructure, dormant until v2 sync ships.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:migrations",
    "build:migrations": "node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "migrate": "node dist/db/migrate-cli.js",
    "migrate:dev": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/services/merge.test.ts src/services/merge.conformance.test.ts src/routes/routes.test.ts src/env.test.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.3.0",
    "pg": "8.22.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "eslint": "9.18.0",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.65.0"
  }
}
