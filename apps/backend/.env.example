# Nex backend — Phase 2 sync API.
# Every variable below is validated at boot by src/env.ts. The process exits
# with code 1 on invalid configuration rather than starting in a broken state.

# Required. No fallback: an unset value fails validation instead of silently
# connecting to a libpq default database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nex

# Optional.
PORT=4000
NODE_ENV=development

# Comma-separated origin allow-list for CORS. Empty means "no browser origin
# is permitted", which is the correct default for a native-client-only API.
ALLOWED_ORIGINS=

# Number of trusted reverse-proxy hops in front of this process (nginx,
# Cloudflare, a load balancer...). 0 means none — trust only the socket's own
# address, never a client-supplied X-Forwarded-For. Set this to the number of
# hops your deployment actually adds; the rate limiters key on req.ip, and an
# unset or wrong value here either sees every request as coming from the same
# proxy (over-throttles real users) or trusts a header any client can forge
# (lets one client hop rate-limit buckets at will). Never set to a bare "true".
TRUST_PROXY=0

# "1" enables POST /sync/test/reset. Never set this in production.
NEX_TEST_MODE=0

# "1" runs pending migrations at boot. Production should leave this at 0 and
# run `npm run migrate` as an explicit deploy step (see docs/06-development.md).
NEX_AUTO_MIGRATE=0

# Sync tuning.
SYNC_PAGE_SIZE=500
PAIRING_CODE_TTL_SECONDS=600

# Tombstones are purged once every known device has pulled past them AND this
# many days have elapsed.
TOMBSTONE_RETENTION_DAYS=30
PURGE_INTERVAL_MINUTES=60

# Both optional, and both required together for POST /feedback to work — with
# either unset, the endpoint answers 503 rather than silently discarding what
# someone typed. Get a bot token from @BotFather; the chat id is whichever
# chat that bot should deliver feedback into (your own DM with the bot works).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
