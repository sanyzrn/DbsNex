// Keep stock resource declarations above the Version block unchanged.
// Replace StringFileInfo with:
BLOCK "StringFileInfo"
BEGIN
    BLOCK "040904e4"
    BEGIN
        VALUE "CompanyName", "Nex" "\0"
        VALUE "FileDescription", "Nex — capture in seconds" "\0"
        VALUE "FileVersion", VERSION_AS_STRING "\0"
        VALUE "InternalName", "Nex" "\0"
        VALUE "LegalCopyright", "Copyright (C) 2026 Nex contributors" "\0"
        VALUE "OriginalFilename", "Nex.exe" "\0"
        VALUE "ProductName", "Nex" "\0"
        VALUE "ProductVersion", VERSION_AS_STRING "\0"
    END
END