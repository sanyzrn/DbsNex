<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Lets the in-app updater hand a downloaded APK to the system installer.
      This is not a silent-install permission: Android still shows its own
      install prompt, and the user must additionally allow Nex to install
      unknown apps once, in device settings. Nex is distributed outside Play,
      so there is no store to do this for it.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Reminders. POST_NOTIFICATIONS is asked for at the moment a reminder
         is first set, not at launch: a permission prompt before anyone has
         seen what the app does is the reliable way to be refused.
         RECEIVE_BOOT_COMPLETED lets the scheduled alarms survive a restart;
         without it every reminder set before a reboot is silently lost. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Keeps the process alive while an installer is downloading.

      The download is Dart's and already survived leaving the update screen,
      but Android suspends the process shortly after the app leaves the screen
      and the transfer stopped with it. An ordinary notification does not
      change that; a foreground service does. `dataSync` is the type Android
      14 requires it to be declared as, and its permission is only checked
      there — declaring it below that changes nothing.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- A reminder that arrives whenever Android gets around to it is not a
         reminder. Without this the only mode available is inexact, which Doze
         defers by hours, so a note due at 09:00 turns up at lunchtime or not
         that day. Declared, requested at the moment a reminder is first set,
         and survivable if refused: NexReminders falls back to inexact rather
         than dropping the feature. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Android 11 package visibility. Opening a note's file with the device's
      default handler resolves the receiving activity first, and without this
      declaration that lookup comes back empty on API 30+ — so every "Open"
      would report "no app can open this file" even with a viewer installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:label="Nex"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.sanyzrn.nex.TEXT_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Where a share lands, and why it is a second Activity rather than
          another intent-filter on the first.

          Sharing into Nex used to open Nex: a launch screen over whatever app
          you were using, a timeline you did not ask for, and a back gesture to
          get out of it. This window is translucent and has no starting window
          of its own, so nothing is painted over the app you shared from; the
          Dart side closes it as soon as the note is written, with a toast
          saying so. An `activity-alias` could not do this — it cannot carry
          its own theme.

          `taskAffinity=""` matches MainActivity: the window belongs to the
          sharing app's task, so finishing it returns there. Excluded from
          recents because it is not somewhere anyone can come back to, and
          `windowDisablePreview` because a starting window is exactly what
          this exists to avoid.
        -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/ShareTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          The receiver that actually posts a scheduled reminder.

          This was missing, and it is why reminders never arrived. The plugin
          ships the class but its own manifest declares nothing but
          permissions, so nothing in the merged manifest claimed the broadcast
          AlarmManager sends when a reminder comes due. Everything upstream of
          it looked correct — `zonedSchedule` returned without throwing, the
          alarm was set, the app said "reminder set" — and the broadcast went
          to a component that did not exist. Android's own notification
          settings for the app showed the tell: no categories at all, because
          the channel is created by this receiver at post time and it had
          never run.
        -->
        <!-- See the FOREGROUND_SERVICE permissions above. Not exported: it is
             started by this app, from its own MethodChannel, and by nothing
             else. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <!-- Delivers a tap on a notification action back into Dart. Declared
             for the same reason and to avoid the same class of silence. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- Re-registers the pending reminder alarms after a restart. The
             plugin ships the receiver; it only has to be declared. Without
             this the alarms are gone after every reboot, and the app has no
             way to know it happened. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver android:name=".CaptureWidgetProvider" android:exported="true" android:label="Nex Capture">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/capture_widget_info" />
        </receiver>
        <meta-data android:name="flutterEmbedding" android:value="2" />
    </application>
</manifest>
