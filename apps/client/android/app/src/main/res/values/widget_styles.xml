<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget text styles, in Nex's type ramp but sized for a glance:
  one label, one title, one row of body, one of metadata.

  Latin text stays on the platform's own sans-serif, which is close enough
  to the app's Inter at the sizes a widget uses and costs the APK nothing.
  Persian text is worth the exception: values-fa-v26 overrides every style
  below with Vazirmatn (res/font/vazirmatn.xml), the app's own Persian
  face, so a Persian home screen does not read the same words in a
  different alphabet than the app inside. The overrides resolve in the
  launcher's process with the device's configuration, which is the only
  configuration a RemoteViews layout is ever inflated with.
-->
<resources>
    <style name="NexWidget.CaptureLabel" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/nex_widget_on_accent</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="NexWidget.Title" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/nex_widget_text</item>
        <item name="android:maxLines">1</item>
    </style>

    <!--
        A step lighter than the rest of the ramp. At two lines per row the
        preview is the only thing on the widget with any quantity of text,
        and at regular weight a screenful of it read as a wall rather than
        as a list. Light is still perfectly legible at 14sp, and it leaves
        the title as the only bold thing on the surface.
    -->
    <style name="NexWidget.RowPreview" parent="">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nex_widget_text</item>
    </style>

    <!-- Under the preview, a step smaller than it used to be beside it:
         beside it, the time took a column of the row's width away from the
         note's own words on every line. -->
    <style name="NexWidget.RowTime" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/nex_widget_text_dim</item>
    </style>

    <!--
        The brief itself. A step up from the row preview because it is the
        only thing on that widget — there is no list for it to be one line
        of — and generously leaded, because emoji-led lines with no leading
        run together into a paragraph, which is the shape the brief was
        rewritten to stop being.
    -->
    <style name="NexWidget.Recap" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nex_widget_text</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="NexWidget.Message" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nex_widget_text_dim</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="NexWidget.EmptyTitle" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/nex_widget_text</item>
        <item name="android:gravity">center</item>
    </style>

    <!--
        The Cycle widget's four lines. Styles rather than inline
        fontFamily attributes on the TextViews (which an inline attribute
        would always win over) so values-fa-v26 can carry the same lines
        in Vazirmatn alongside every other widget word.
    -->
    <style name="NexWidget.CycleTitle" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nex_cycle_text_dim</item>
    </style>

    <style name="NexWidget.CycleHeadline" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/nex_cycle_text</item>
    </style>

    <style name="NexWidget.CycleSubline" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/nex_cycle_text_dim</item>
    </style>

    <style name="NexWidget.CycleWhisper" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nex_cycle_text_dim</item>
    </style>
</resources>
