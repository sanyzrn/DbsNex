<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sampled directly from the launcher icon artwork's own background
         fill, so the adaptive-icon background layer never shows a seam
         against the foreground bitmap's baked-in corners. -->
    <color name="nex_icon_background">#1D1D1D</color>
    <color name="nex_launch_light">#F5F6F6</color>
    <color name="nex_launch_dark">#131312</color>

    <!-- The home-screen widgets' palette, copied token for token from
         packages/ui/lib/tokens/nex_tokens.dart (NexColors). The widget cannot
         read Dart constants and tokens must not drift into hand-spelled hex,
         so every line here names the token it mirrors:
           nex_widget_accent      accentStrongLight / accentStrongDark — the
                                  capture button's fill, the same value the FAB
                                  paints;
           nex_widget_on_accent   onAccent;
           nex_widget_card        bgCardLight / bgCardDark;
           nex_widget_text        textPrimaryLight / textPrimaryDark;
           nex_widget_text_dim    textSecondaryLight / textSecondaryDark;
           nex_widget_stroke      the hairline between card and page. The card
                                  token bgElevated is the closest quiet step in
                                  both ramps and is what is used here; a widget
                                  on the launcher has no shadow to fall back on,
                                  so the hairline does the card's edge alone.
         Android 12+ replaces the whole set with wallpaper-derived Material You
         colors — see values-v31/colors.xml. -->
    <color name="nex_widget_accent">#1D4ED8</color>
    <color name="nex_widget_on_accent">#FFFFFF</color>
    <color name="nex_widget_card">#FFFFFF</color>
    <color name="nex_widget_text">#262626</color>
    <color name="nex_widget_text_dim">#5C5C5C</color>
    <color name="nex_widget_stroke">#E0E0E0</color>
    <!-- The capture buttons' pill: the text colour at a few percent. -->
    <color name="nex_widget_action">#10262626</color>

    <!-- Cycle's own space on the home screen (CycleWidgetProvider). -->
    <color name="nex_cycle_bg_start">#FCEAF0</color>
    <color name="nex_cycle_bg_end">#F1EAFB</color>
    <color name="nex_cycle_stroke">#D9FFFFFF</color>
    <color name="nex_cycle_text">#3A2430</color>
    <color name="nex_cycle_text_dim">#7A6470</color>
    <color name="nex_cycle_rose">#D9506F</color>
    <color name="nex_cycle_teal">#2E9C88</color>
</resources>
