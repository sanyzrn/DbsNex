<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sampled directly from the launcher icon artwork's own background
         fill, so the adaptive-icon background layer never shows a seam
         against the foreground bitmap's baked-in corners. -->
    <color name="nex_icon_background">#1D1D1D</color>
    <color name="nex_launch_light">#FFFFFF</color>
    <color name="nex_launch_dark">#141821</color>

    <!-- Widget colours mirror the current app's flat appearance tokens:
         NexSoftLightColors (packages/ui/lib/tokens/nex_soft_appearances.dart),
         NexSoftDarkColors (packages/ui/lib/tokens/nex_soft_dark.dart), and
         NexColors.accentStrongLight for the readable light capture/action fill.
         Light: card/text/muted/elevated map to the corresponding Soft Light
         tokens. Action is the light text colour at low alpha (ARGB).
         Night-qualified widget colours mirror Soft Dark, not OLED Night;
         Android 12+ overrides widgets with wallpaper-based Material You in
         values-v31/colors.xml and values-night-v31/colors.xml. -->
    <color name="nex_widget_accent">#006DCC</color>
    <!-- The top end of the Capture tile's fill: the accent with a measure
         of white worked in, the way a lit surface is lighter where it
         faces the light. v31 takes the neighbouring system-palette step
         instead, so a Material You tile keeps the wallpaper's own step. -->
    <color name="nex_widget_accent_hi">#1F7ED2</color>
    <color name="nex_widget_on_accent">#FFFFFF</color>
    <color name="nex_widget_card">#F4F5F8</color>
    <color name="nex_widget_text">#14171C</color>
    <color name="nex_widget_text_dim">#626B7A</color>
    <color name="nex_widget_stroke">#E9ECF1</color>
    <!-- The capture buttons' pill: the text colour at a few percent. -->
    <color name="nex_widget_action">#1014171C</color>
    <!-- The press feedback over that pill: the same text colour at a fifth,
         because the fill's own six percent would never be seen. -->
    <color name="nex_widget_ripple">#2E14171C</color>

    <!-- Cycle's own space on the home screen (CycleWidgetProvider). -->
    <color name="nex_cycle_bg_start">#FCEAF0</color>
    <color name="nex_cycle_bg_end">#F1EAFB</color>
    <color name="nex_cycle_stroke">#D9FFFFFF</color>
    <color name="nex_cycle_text">#3A2430</color>
    <color name="nex_cycle_text_dim">#7A6470</color>
    <color name="nex_cycle_rose">#D9506F</color>
    <color name="nex_cycle_teal">#2E9C88</color>
</resources>
