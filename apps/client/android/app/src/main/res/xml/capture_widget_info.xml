<?xml version="1.0" encoding="utf-8"?>
<!--
  The Capture widget.

  One cell by default (targetCellWidth/Height on Android 12+, the 40dp
  formula below it: one cell ≈ 70dp × cells − 30). It stretches horizontally
  — at two cells the label appears — but never vertically: a taller button
  would be a bigger promise than "tap to capture" needs to make.
  updatePeriodMillis stays 0 — the widget has no data to refresh, and the
  app pushes any render it owes (locale change) itself.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:maxResizeWidth="250dp"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/capture_widget"
    android:previewImage="@drawable/nex_widget_preview_capture"
    android:previewLayout="@layout/capture_widget"
    android:widgetCategory="home_screen"
    android:description="@string/widget_capture_description" />
