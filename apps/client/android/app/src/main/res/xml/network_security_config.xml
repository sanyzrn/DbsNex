<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is denied, everywhere, in the builds people install (2.3.5).

  The loopback exceptions a developer needs to reach a backend on the host
  machine (10.0.2.2, 127.0.0.1, localhost) live in the debug build's copy of
  this file, src/debug/res/xml/network_security_config.xml, which replaces this
  one there. Nothing a release does talks to a loopback address, and a store's
  security scan reads a cleartext exception as a weakness whatever it is for.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
