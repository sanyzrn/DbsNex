<?xml version="1.0" encoding="utf-8"?>
<!--
  The Timeline widget.

  Three cells wide by two tall on placement — enough for the header and two
  rows — and resizable from there to five wide by six tall. The ListView
  simply reveals more of the stream as the box grows, so the only thing the
  ceiling decides is how much of the timeline a glance can hold.

  The maxima are in dp because that is the only unit the manifest has for
  them; the launcher's own cell is 70dp minus a 30dp gutter, so n cells is
  70n - 30. Five wide is 320dp and six tall is 390dp. They used to be 250dp
  each, which is barely three cells — the widget could not be made big
  enough to be worth the space it asked for.

  updatePeriodMillis is 0 by design: nothing here refreshes on a timer,
  because nothing here is allowed to go stale — the app re-renders the widget
  the moment its own data moves.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="140dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="390dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_timeline"
    android:previewImage="@drawable/nex_widget_preview_timeline"
    android:previewLayout="@layout/widget_timeline"
    android:widgetCategory="home_screen"
    android:description="@string/widget_timeline_description" />
