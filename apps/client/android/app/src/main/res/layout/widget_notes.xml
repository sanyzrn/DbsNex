<?xml version="1.0" encoding="utf-8"?>
<!-- The recent-notes widget: a header with the Nex mark and a refresh
     button, the scrollable note list fed by RemoteViewsService, and a
     New note footer. Everything is restyled in code per theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_notes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:background="@drawable/widget_card_bg_light"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/notes_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:text="Nex"
            android:textColor="#FF262626"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notes_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:text="Recent notes"
            android:textColor="#FF5C5C5C"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/notes_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_refresh"
            android:padding="10dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <ListView
        android:id="@+id/notes_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/notes_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/notes_add_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_add" />

        <TextView
            android:id="@+id/notes_add_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans"
            android:text="New note"
            android:textColor="#FF262626"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
