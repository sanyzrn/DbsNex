<?xml version="1.0" encoding="utf-8"?>
<!--
  The Recap widget: the assistant's brief and nothing else.

  A second widget rather than a panel on the Timeline one, because they
  answer different questions. The Timeline widget says what you wrote; this
  says what is waiting on you — a few emoji-led lines, the same text the
  recap card at the top of the timeline is showing. Somebody who wants one
  does not necessarily want the other, and a home screen is where that
  choice belongs.

  Header — the Nex logotype, as on the Timeline widget, and nothing else:
  the "Smart summary" title and its glyph named what the widget plainly
  is, and the refresh button sent you into the app anyway. A tap on the
  empty prompt asks for a new brief; a tap anywhere else opens the app,
  which brings the brief up to date as it opens.

  The brief is a list, one row per line, rather than one TextView. The
  widget is resizable and the launcher decides how tall it is; a TextView
  was clipped by a box shorter than the brief, and a home-screen widget has
  no other way to scroll. A list scrolls, and a taller widget still simply
  shows more of it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nex_recap_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:background="@drawable/nex_widget_bg_card">

    <LinearLayout
        android:id="@+id/nex_recap_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp">

        <ImageView
            android:id="@+id/nex_recap_glyph"
            android:layout_width="52dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/nex_widget_ic_mark" />
    </LinearLayout>

    <ListView
        android:id="@+id/nex_recap_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="14dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/nex_recap_locked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/nex_widget_ic_lock" />

        <TextView
            android:id="@+id/nex_recap_locked_text"
            style="@style/NexWidget.Message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nex_recap_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nex_recap_empty_title"
            style="@style/NexWidget.EmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <TextView
            android:id="@+id/nex_recap_empty_hint"
            style="@style/NexWidget.Message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
