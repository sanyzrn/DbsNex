<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows for the Recap widget on Android 12+.

  The same story as widget_timeline_preview.xml: previewLayout wins over
  the static image on S+, and the live layout's ListView holds no lines
  until real data binds, so the picker was showing a blank card for the
  brief. Three sample lines, led the way a real brief leads, in the
  widget's own type style and spacing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nex_recap_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:background="@drawable/nex_widget_bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/nex_widget_ic_mark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp">

        <TextView
            style="@style/NexWidget.Recap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_recap1" />

        <TextView
            style="@style/NexWidget.Recap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_recap2" />

        <TextView
            style="@style/NexWidget.Recap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_recap3" />
    </LinearLayout>
</LinearLayout>
