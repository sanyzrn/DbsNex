<?xml version="1.0" encoding="utf-8"?>
<!--
  The Timeline widget: a card holding the top of the timeline.

  Header — the Nex logotype alone (tapping it opens the app); the app name
  beside it said the same word twice. Under it, the capture row: a note, a
  voice note, a photo from the camera or the gallery, and a checklist, each
  one tap from the home screen — the + it replaces could only start a text
  note. Below that, one of three bodies the provider swaps between: the
  list of recent captures, the locked notice, or the empty prompt. All
  three keep the header and the capture row, because capture never depends
  on the library being readable.

  Two rows rather than one because the widget can be as narrow as three
  cells: five buttons beside the logotype would not leave a finger room to
  pick one. Equal weights give each button the same share of whatever width
  the launcher grants.

  Padding is small and deliberate: the widget is a card on the launcher's
  desk, so it keeps Nex's card geometry — its own fill, a 1px hairline, a
  corner radius the system sets on Android 12+ — and leaves the inner edges
  to the rows themselves.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nex_widget_timeline_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:background="@drawable/nex_widget_bg_card">

    <LinearLayout
        android:id="@+id/nex_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp">

        <ImageView
            android:id="@+id/nex_widget_brand"
            android:layout_width="52dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/nex_widget_ic_mark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nex_widget_capture_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/nex_widget_capture_note"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/nex_widget_bg_action">

            <ImageView
                android:id="@+id/nex_widget_capture_note_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/nex_widget_ic_type_text" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nex_widget_capture_voice"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/nex_widget_bg_action">

            <ImageView
                android:id="@+id/nex_widget_capture_voice_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/nex_widget_ic_type_voice" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nex_widget_capture_camera"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/nex_widget_bg_action">

            <ImageView
                android:id="@+id/nex_widget_capture_camera_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/nex_widget_ic_camera" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nex_widget_capture_gallery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/nex_widget_bg_action">

            <ImageView
                android:id="@+id/nex_widget_capture_gallery_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/nex_widget_ic_gallery" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nex_widget_capture_checklist"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/nex_widget_bg_action">

            <ImageView
                android:id="@+id/nex_widget_capture_checklist_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/nex_widget_ic_type_checklist" />
        </FrameLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/nex_widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/nex_widget_locked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/nex_widget_ic_lock" />

        <TextView
            android:id="@+id/nex_widget_locked_text"
            style="@style/NexWidget.Message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nex_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nex_widget_empty_title"
            style="@style/NexWidget.EmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center" />

        <TextView
            android:id="@+id/nex_widget_empty_hint"
            style="@style/NexWidget.Message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
