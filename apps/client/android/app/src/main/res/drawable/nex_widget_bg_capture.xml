<?xml version="1.0" encoding="utf-8"?>
<!--
  The Capture tile: the FAB's accent, given the depth the flat fill could
  not carry. The fill runs from the lighter step at the top into the
  accent itself, the way a lit surface is lighter where it faces the
  light; a hairline of translucent white rides the inner edge, which is
  what separates a raised button from a coloured rectangle on a wallpaper.

  Rounded to the widget corner radius the system reports on Android 12+
  (20dp on older releases). A custom accent seed is applied as a colour
  filter over the whole drawable, which flattens the gradient to the one
  colour — the honest result, and contrast is still the filter's own job
  (NexWidgetAppearance.foreground).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/nex_widget_accent_hi"
                android:endColor="@color/nex_widget_accent"
                android:type="linear" />
            <corners android:radius="@dimen/nex_widget_corner" />
        </shape>
    </item>
    <item android:gravity="fill">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
            <corners android:radius="@dimen/nex_widget_corner" />
        </shape>
    </item>
</layer-list>
