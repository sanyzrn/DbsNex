<?xml version="1.0" encoding="utf-8"?>
<!--
  Cycle's ground on the home screen: the same blush into lavender as the
  page in the app (plum into deep violet at night, from values-night), a
  hairline of light at the edge, and large soft corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/nex_cycle_bg_start"
        android:endColor="@color/nex_cycle_bg_end"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/nex_cycle_stroke" />
    <corners android:radius="26dp" />
</shape>
