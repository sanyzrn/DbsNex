<?xml version="1.0" encoding="utf-8"?>
<!--
  The Timeline widget's card: Nex's card fill on a hairline boundary, the
  same three signals (fill, border, corner) a timeline card gets. Elevation
  is not available to RemoteViews, so the 1px stroke carries the edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nex_widget_card" />
    <stroke
        android:width="1dp"
        android:color="@color/nex_widget_stroke" />
    <corners android:radius="@dimen/nex_widget_corner" />
</shape>
