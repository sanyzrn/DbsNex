<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon for Nex's notifications.

  Android silhouettes a notification icon: it throws the colours away and
  keeps the alpha, so anything with a filled background arrives as a solid
  white blob — which is exactly what the launcher icon was doing here. This is
  the mark redrawn as line art on transparency, which is the only shape that
  survives that treatment.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M20.2,12 A8.2,8.2 0 0,1 3.8,12 A8.2,8.2 0 0,1 12,3.8" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M7,12 A5,5 0 0,1 17,12 A5,5 0 0,1 12,17" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12m-1.9,0a1.9,1.9 0 1,0 3.8,0a1.9,1.9 0 1,0 -3.8,0" />
</vector>
