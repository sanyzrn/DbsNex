<?xml version="1.0" encoding="utf-8"?>
<!--
  Ask again: a circular arrow, in the same line style as every other glyph
  on the widgets.

  Drawn as one arc with a gap rather than as a closed ring, because the gap
  is what the arrowhead sits in — a full circle with a head stuck on the
  outside reads as a clock with a fault. The arc runs the long way round
  (large-arc, clockwise) and ends at the top right, where the head points
  back into the direction of travel.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="@color/nex_widget_on_accent"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M18.8,9.5 A7.2,7.2 0 1 1 14.5,5.2" />
    <path
        android:strokeColor="@color/nex_widget_on_accent"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12.5,2.4 L14.5,5.2 L11.1,6.2" />
</vector>
