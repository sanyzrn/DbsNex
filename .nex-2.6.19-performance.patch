+    db.close();
+    db = NexDatabase.open(p.join(tmp.path, 'nex.sqlite'));
+    repo = SqliteNoteRepository(db);
+
+    final usage = LibraryMaintenance(
+      repo,
+      mediaRoot: tmp.path,
+    ).tagUsage(timelineOnly: true);
